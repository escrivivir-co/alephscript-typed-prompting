      "typeScript": "interface Product {\n  id: string;\n  name: string;\n  price: number;\n  description?: string;\n  quantityAvailable: number;\n}\n\ninterface OrderItem {\n  product: Product;\n  quantity: number;\n}\n\ninterface Order {\n  id: string;\n  items: OrderItem[];\n  totalAmount: number;\n  status: 'pending' | 'completed' | 'cancelled';\n  orderDate: Date;\n  customerName: string;\n  shippingAddress: string;\n}\nexport interface TypedMessage { content: Order }",
      "jsonSchema": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"$ref\": \"#/definitions/TypedMessage\",\n  \"definitions\": {\n    \"TypedMessage\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"content\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"id\": {\n              \"type\": \"string\"\n            },\n            \"items\": {\n              \"type\": \"array\",\n              \"items\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"product\": {\n                    \"type\": \"object\",\n                    \"properties\": {\n                      \"id\": {\n                        \"type\": \"string\"\n                      },\n                      \"name\": {\n                        \"type\": \"string\"\n                      },\n                      \"price\": {\n                        \"type\": \"number\"\n                      },\n                      \"description\": {\n                        \"type\": \"string\"\n                      },\n                      \"quantityAvailable\": {\n                        \"type\": \"number\"\n                      }\n                    },\n                    \"required\": [\n                      \"id\",\n                      \"name\",\n                      \"price\",\n                      \"quantityAvailable\"\n                    ],\n                    \"additionalProperties\": false\n                  },\n                  \"quantity\": {\n                    \"type\": \"number\"\n                  }\n                },\n                \"required\": [\n                  \"product\",\n                  \"quantity\"\n                ],\n                \"additionalProperties\": false\n              }\n            },\n            \"totalAmount\": {\n              \"type\": \"number\"\n            },\n            \"status\": {\n              \"type\": \"string\",\n              \"enum\": [\n                \"pending\",\n                \"completed\",\n                \"cancelled\"\n              ]\n            },\n            \"orderDate\": {\n              \"type\": \"string\",\n              \"format\": \"date-time\"\n            },\n            \"customerName\": {\n              \"type\": \"string\"\n            },\n            \"shippingAddress\": {\n              \"type\": \"string\"\n            }\n          },\n          \"required\": [\n            \"id\",\n            \"items\",\n            \"totalAmount\",\n            \"status\",\n            \"orderDate\",\n            \"customerName\",\n            \"shippingAddress\"\n          ],\n          \"additionalProperties\": false\n        }\n      },\n      \"required\": [\n        \"content\"\n      ],\n      \"additionalProperties\": false\n    }\n  }\n}",
