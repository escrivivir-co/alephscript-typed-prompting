      "jsonSchema": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"definitions\": {\n    \"User\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": {\n          \"type\": \"number\"\n        },\n        \"name\": {\n          \"type\": \"string\"\n        },\n        \"email\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"id\",\n        \"name\",\n        \"email\"\n      ],\n      \"additionalProperties\": false\n    },\n    \"Product\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": {\n          \"type\": \"number\"\n        },\n        \"name\": {\n          \"type\": \"string\"\n        },\n        \"price\": {\n          \"type\": \"number\"\n        }\n      },\n      \"required\": [\n        \"id\",\n        \"name\",\n        \"price\"\n      ],\n      \"additionalProperties\": false\n    },\n    \"Order\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": {\n          \"type\": \"number\"\n        },\n        \"userId\": {\n          \"type\": \"number\"\n        },\n        \"productId\": {\n          \"type\": \"number\"\n        },\n        \"quantity\": {\n          \"type\": \"number\"\n        }\n      },\n      \"required\": [\n        \"id\",\n        \"userId\",\n        \"productId\",\n        \"quantity\"\n      ],\n      \"additionalProperties\": false\n    },\n    \"TypedMessage\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"content\": {\n          \"$ref\": \"#/definitions/Order\"\n        }\n      },\n      \"required\": [\n        \"content\"\n      ],\n      \"additionalProperties\": false\n    }\n  }\n}",
